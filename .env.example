# Telegram Bot (from @BotFather)
BOT_TOKEN=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2

# Bitrix24 OAuth (server-side app)
BITRIX_CLIENT_ID=
BITRIX_CLIENT_SECRET=

# External URL for OAuth callback (e.g. https://your-domain.com)
BASE_URL=http://localhost:8002

# Database
DB_PATH=data/arkadyjarvis.db

# Scheduler
SUMMARY_HOUR=19
SUMMARY_MINUTE=0
TIMEZONE=Asia/Novosibirsk

# Wednesday frog meme — sent to this chat every Wed at 10:00 local time. 0 = disabled.
WEDNESDAY_FROG_CHAT_ID=0

# OpenRouter text/audio model (voice transcription, etc.)
OPENROUTER_MODEL=google/gemini-2.5-pro

# Monday Soviet-style motivational poster — sent every Mon at 09:00 local time. 0 = disabled.
MONDAY_POSTER_CHAT_ID=0
